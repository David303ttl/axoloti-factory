<objdefs>
   <obj.normal id="flashread interp" uuid="3bee14d4674a0d360d134757716120ffc29310a4" sha="5bf8648b0d5a5df01bb9d8aeb6f62cb164d7a6eb">
      <upgradeSha>ee182884ff6601bedd6fe14e6f89cd89864e3b20</upgradeSha>
      <sDescription>linear interpolated flash table read</sDescription>
      <author>Johannes Taelman</author>
      <license>BSD</license>
      <inlets>
         <frac32buffer name="pos" description="position"/>
      </inlets>
      <outlets>
         <frac32buffer name="o" description="output"/>
      </outlets>
      <displays/>
      <params/>
      <attribs>
         <combo name="sample">
            <MenuEntries>
               <string>808bd</string>
               <string>808hatclose</string>
               <string>808hatopen</string>
               <string>808hitom</string>
               <string>808midtom</string>
               <string>808lotom</string>
               <string>808snare</string>
            </MenuEntries>
            <CEntries>
               <string>bd</string>
               <string>hatclose</string>
               <string>hatopen</string>
               <string>hitom</string>
               <string>midtom</string>
               <string>lotom</string>
               <string>snare</string>
            </CEntries>
         </combo>
         <combo name="size">
            <MenuEntries>
               <string>2</string>
               <string>4</string>
               <string>8</string>
               <string>16</string>
               <string>32</string>
               <string>64</string>
               <string>128</string>
               <string>256</string>
               <string>512</string>
               <string>1024</string>
               <string>2048</string>
               <string>4096</string>
               <string>8192</string>
               <string>16384</string>
               <string>32768</string>
               <string>65536</string>
            </MenuEntries>
            <CEntries>
               <string>1</string>
               <string>2</string>
               <string>3</string>
               <string>4</string>
               <string>5</string>
               <string>6</string>
               <string>7</string>
               <string>8</string>
               <string>9</string>
               <string>10</string>
               <string>11</string>
               <string>12</string>
               <string>13</string>
               <string>14</string>
               <string>15</string>
               <string>16</string>
            </CEntries>
         </combo>
      </attribs>
      <code.declaration><![CDATA[const int16_t *sample;
uint32_t smp_length;
static const uint32_t LENGTH = (1u<<attr_size);
static const uint32_t GAIN = 12;
]]></code.declaration>
      <code.init><![CDATA[extern const uint8_t _binary_attr_sample_raw_start[];
extern const uint8_t _binary_attr_sample_raw_end[];
sample = (const int16_t *)_binary_attr_sample_raw_start;
smp_length = (uint32_t)(_binary_attr_sample_raw_end - _binary_attr_sample_raw_start);
]]></code.init>
      <code.srate><![CDATA[uint32_t sample_count = smp_length / sizeof(int16_t);
if (sample == 0 || sample_count == 0) outlet_o = 0;
else {
  uint32_t table_count = sample_count < LENGTH ? sample_count : LENGTH;
  uint32_t asat = __USAT(inlet_pos,27);
  uint64_t scaled = (uint64_t)asat * table_count;
  uint32_t index = (uint32_t)(scaled>>27);
  if (index >= table_count) index = table_count - 1;
  uint32_t next = index + 1 < table_count ? index + 1 : index;
  int32_t y1 = (int32_t)sample[index] * (1<<GAIN);
  int32_t y2 = (int32_t)sample[next] * (1<<GAIN);
  int32_t rr;
  if (next == index) outlet_o = y1;
  else {
    int32_t frac = (int32_t)((scaled - ((uint64_t)index<<27))<<3);
    rr = ___SMMUL(y1,(1<<30)-frac);
    rr = ___SMMLA(y2,frac,rr);
    outlet_o = rr * 4;
  }
}
]]></code.srate>
   </obj.normal>
</objdefs>